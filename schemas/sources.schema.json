{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:corelift:sources:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "checked_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "checked_at",
          "revision",
          "scope"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false
}
