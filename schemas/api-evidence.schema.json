{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:corelift:api-evidence:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "target": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "enum": [
            "S4HANA",
            "ECC"
          ]
        },
        "edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "enum": [
            "private",
            "public",
            "on-premise"
          ]
        },
        "release": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "fps": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "family",
        "edition",
        "release",
        "fps"
      ],
      "additionalProperties": false
    },
    "snapshot_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "enum": [
              "released",
              "classic",
              "internal",
              "not-recommended",
              "unknown"
            ]
          },
          "contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "enum": [
              "C0",
              "C1",
              "C2",
              "none",
              "unknown"
            ]
          },
          "remote_pathway": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "enum": [
              "endorsed",
              "not-endorsed",
              "unknown"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "enum": [
              "synthetic",
              "exported-unverified"
            ]
          },
          "supported_operations": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "write",
                "call",
                "render"
              ]
            },
            "uniqueItems": true,
            "maxItems": 4
          },
          "endorsed_operations": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "write",
                "call",
                "render"
              ]
            },
            "uniqueItems": true,
            "maxItems": 4
          }
        },
        "required": [
          "object",
          "state",
          "contract",
          "remote_pathway",
          "source_id",
          "verification",
          "supported_operations",
          "endorsed_operations"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "target",
    "snapshot_revision",
    "objects"
  ],
  "additionalProperties": false
}
